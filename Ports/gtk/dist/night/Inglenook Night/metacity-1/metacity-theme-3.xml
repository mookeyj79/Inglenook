<?xml version="1.0"?>
<!-- Inglenook Night window borders for Marco (MATE), Muffin (Cinnamon) and Metacity.
     Inglenook 0.1.0, https://github.com/mookeyj79/Inglenook
     Generated from the palette. Solid colors only: no gradients, no images, no shadows. -->
<metacity_theme>
  <info>
    <name>Inglenook Night</name>
    <author>Inglenook contributors</author>
    <copyright>MIT License</copyright>
    <date>0.1.0</date>
    <description>Inglenook Night window borders.</description>
  </info>

  <!-- Geometry -->

  <frame_geometry name="normal" title_scale="medium" rounded_top_left="4" rounded_top_right="4">
    <distance name="left_width" value="1"/>
    <distance name="right_width" value="1"/>
    <distance name="bottom_height" value="1"/>
    <distance name="left_titlebar_edge" value="6"/>
    <distance name="right_titlebar_edge" value="6"/>
    <distance name="title_vertical_pad" value="10"/>
    <aspect_ratio name="button" value="1.0"/>
    <border name="title_border" left="10" right="10" top="1" bottom="0"/>
    <border name="button_border" left="2" right="2" top="3" bottom="3"/>
  </frame_geometry>

  <frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false">
    <distance name="left_width" value="0"/>
    <distance name="right_width" value="0"/>
    <distance name="bottom_height" value="0"/>
  </frame_geometry>

  <frame_geometry name="small" parent="normal" title_scale="small">
    <distance name="title_vertical_pad" value="6"/>
    <border name="button_border" left="2" right="2" top="2" bottom="2"/>
  </frame_geometry>

  <frame_geometry name="border" has_title="false" rounded_top_left="false" rounded_top_right="false">
    <distance name="left_width" value="1"/>
    <distance name="right_width" value="1"/>
    <distance name="bottom_height" value="1"/>
    <distance name="left_titlebar_edge" value="0"/>
    <distance name="right_titlebar_edge" value="0"/>
    <distance name="button_width" value="0"/>
    <distance name="button_height" value="0"/>
    <distance name="title_vertical_pad" value="1"/>
    <border name="title_border" left="0" right="0" top="0" bottom="0"/>
    <border name="button_border" left="0" right="0" top="0" bottom="0"/>
  </frame_geometry>

  <constant name="IconPad" value="5"/>

  <!-- Frame backgrounds: the title bar surface with a one-pixel outline. -->

  <draw_ops name="frame_focused">
    <rectangle color="#12100e" filled="true" x="0" y="0" width="width" height="height"/>
    <rectangle color="#363331" filled="false" x="0" y="0" width="width - 1" height="height - 1"/>
  </draw_ops>

  <draw_ops name="frame_unfocused">
    <rectangle color="#171412" filled="true" x="0" y="0" width="width" height="height"/>
    <rectangle color="#363331" filled="false" x="0" y="0" width="width - 1" height="height - 1"/>
  </draw_ops>

  <draw_ops name="frame_maximized_focused">
    <rectangle color="#12100e" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <draw_ops name="frame_maximized_unfocused">
    <rectangle color="#171412" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <draw_ops name="titlebar_bottom_line">
    <line color="#363331" x1="0" y1="height - 1" x2="width" y2="height - 1"/>
  </draw_ops>

  <draw_ops name="blank">
  </draw_ops>

  <!-- Titles -->

  <draw_ops name="title_focused">
    <title color="#d1c9bc" x="(0 `max` ((width - title_width) / 2))" y="(0 `max` ((height - title_height) / 2))"/>
  </draw_ops>

  <draw_ops name="title_unfocused">
    <title color="#8f887f" x="(0 `max` ((width - title_width) / 2))" y="(0 `max` ((height - title_height) / 2))"/>
  </draw_ops>

  <!-- Button backgrounds: none at rest, the hover surface under the pointer, the accent when pressed. -->

  <draw_ops name="button_hover_bg">
    <rectangle color="#312e2c" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <draw_ops name="button_pressed_bg">
    <rectangle color="#f3a958" filled="true" x="0" y="0" width="width" height="height"/>
  </draw_ops>

  <!-- Button glyphs, drawn with lines in one color each. -->

  <draw_ops name="close_glyph_dim">
    <line color="#b1aa9e" width="2" x1="IconPad" y1="IconPad" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
    <line color="#b1aa9e" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="IconPad"/>
  </draw_ops>
  <draw_ops name="close_glyph_text">
    <line color="#d1c9bc" width="2" x1="IconPad" y1="IconPad" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
    <line color="#d1c9bc" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="IconPad"/>
  </draw_ops>
  <draw_ops name="close_glyph_faint">
    <line color="#8f887f" width="2" x1="IconPad" y1="IconPad" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
    <line color="#8f887f" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="IconPad"/>
  </draw_ops>
  <draw_ops name="close_glyph_on_accent">
    <line color="#12100e" width="2" x1="IconPad" y1="IconPad" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
    <line color="#12100e" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="IconPad"/>
  </draw_ops>

  <draw_ops name="maximize_glyph_dim">
    <rectangle color="#b1aa9e" filled="false" x="IconPad" y="IconPad" width="width - IconPad * 2 - 1" height="height - IconPad * 2 - 1"/>
    <line color="#b1aa9e" x1="IconPad" y1="IconPad + 1" x2="width - IconPad - 1" y2="IconPad + 1"/>
  </draw_ops>
  <draw_ops name="maximize_glyph_text">
    <rectangle color="#d1c9bc" filled="false" x="IconPad" y="IconPad" width="width - IconPad * 2 - 1" height="height - IconPad * 2 - 1"/>
    <line color="#d1c9bc" x1="IconPad" y1="IconPad + 1" x2="width - IconPad - 1" y2="IconPad + 1"/>
  </draw_ops>
  <draw_ops name="maximize_glyph_faint">
    <rectangle color="#8f887f" filled="false" x="IconPad" y="IconPad" width="width - IconPad * 2 - 1" height="height - IconPad * 2 - 1"/>
    <line color="#8f887f" x1="IconPad" y1="IconPad + 1" x2="width - IconPad - 1" y2="IconPad + 1"/>
  </draw_ops>
  <draw_ops name="maximize_glyph_on_accent">
    <rectangle color="#12100e" filled="false" x="IconPad" y="IconPad" width="width - IconPad * 2 - 1" height="height - IconPad * 2 - 1"/>
    <line color="#12100e" x1="IconPad" y1="IconPad + 1" x2="width - IconPad - 1" y2="IconPad + 1"/>
  </draw_ops>

  <draw_ops name="restore_glyph_dim">
    <rectangle color="#b1aa9e" filled="false" x="IconPad + 2" y="IconPad" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
    <rectangle color="#b1aa9e" filled="false" x="IconPad" y="IconPad + 2" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
  </draw_ops>
  <draw_ops name="restore_glyph_text">
    <rectangle color="#d1c9bc" filled="false" x="IconPad + 2" y="IconPad" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
    <rectangle color="#d1c9bc" filled="false" x="IconPad" y="IconPad + 2" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
  </draw_ops>
  <draw_ops name="restore_glyph_faint">
    <rectangle color="#8f887f" filled="false" x="IconPad + 2" y="IconPad" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
    <rectangle color="#8f887f" filled="false" x="IconPad" y="IconPad + 2" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
  </draw_ops>
  <draw_ops name="restore_glyph_on_accent">
    <rectangle color="#12100e" filled="false" x="IconPad + 2" y="IconPad" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
    <rectangle color="#12100e" filled="false" x="IconPad" y="IconPad + 2" width="width - IconPad * 2 - 3" height="height - IconPad * 2 - 3"/>
  </draw_ops>

  <draw_ops name="minimize_glyph_dim">
    <line color="#b1aa9e" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
  </draw_ops>
  <draw_ops name="minimize_glyph_text">
    <line color="#d1c9bc" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
  </draw_ops>
  <draw_ops name="minimize_glyph_faint">
    <line color="#8f887f" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
  </draw_ops>
  <draw_ops name="minimize_glyph_on_accent">
    <line color="#12100e" width="2" x1="IconPad" y1="height - IconPad - 1" x2="width - IconPad - 1" y2="height - IconPad - 1"/>
  </draw_ops>

  <draw_ops name="menu_glyph">
    <icon x="(width - mini_icon_width) / 2" y="(height - mini_icon_height) / 2" width="mini_icon_width" height="mini_icon_height"/>
  </draw_ops>

  <!-- Buttons, by state -->

  <draw_ops name="close_focused"><include name="close_glyph_dim"/></draw_ops>
  <draw_ops name="close_unfocused"><include name="close_glyph_faint"/></draw_ops>
  <draw_ops name="close_prelight"><include name="button_hover_bg"/><include name="close_glyph_text"/></draw_ops>
  <draw_ops name="close_pressed"><include name="button_pressed_bg"/><include name="close_glyph_on_accent"/></draw_ops>

  <draw_ops name="maximize_focused"><include name="maximize_glyph_dim"/></draw_ops>
  <draw_ops name="maximize_unfocused"><include name="maximize_glyph_faint"/></draw_ops>
  <draw_ops name="maximize_prelight"><include name="button_hover_bg"/><include name="maximize_glyph_text"/></draw_ops>
  <draw_ops name="maximize_pressed"><include name="button_pressed_bg"/><include name="maximize_glyph_on_accent"/></draw_ops>

  <draw_ops name="restore_focused"><include name="restore_glyph_dim"/></draw_ops>
  <draw_ops name="restore_unfocused"><include name="restore_glyph_faint"/></draw_ops>
  <draw_ops name="restore_prelight"><include name="button_hover_bg"/><include name="restore_glyph_text"/></draw_ops>
  <draw_ops name="restore_pressed"><include name="button_pressed_bg"/><include name="restore_glyph_on_accent"/></draw_ops>

  <draw_ops name="minimize_focused"><include name="minimize_glyph_dim"/></draw_ops>
  <draw_ops name="minimize_unfocused"><include name="minimize_glyph_faint"/></draw_ops>
  <draw_ops name="minimize_prelight"><include name="button_hover_bg"/><include name="minimize_glyph_text"/></draw_ops>
  <draw_ops name="minimize_pressed"><include name="button_pressed_bg"/><include name="minimize_glyph_on_accent"/></draw_ops>

  <draw_ops name="menu_prelight"><include name="button_hover_bg"/><include name="menu_glyph"/></draw_ops>
  <draw_ops name="menu_pressed"><include name="button_pressed_bg"/><include name="menu_glyph"/></draw_ops>

  <!-- Frame styles -->

  <frame_style name="normal_focused" geometry="normal">
    <piece position="entire_background" draw_ops="frame_focused"/>
    <piece position="titlebar" draw_ops="titlebar_bottom_line"/>
    <piece position="title" draw_ops="title_focused"/>
    <button function="close" state="normal" draw_ops="close_focused"/>
    <button function="close" state="prelight" draw_ops="close_prelight"/>
    <button function="close" state="pressed" draw_ops="close_pressed"/>
    <button function="maximize" state="normal" draw_ops="maximize_focused"/>
    <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
    <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
    <button function="minimize" state="normal" draw_ops="minimize_focused"/>
    <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
    <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
    <button function="menu" state="normal" draw_ops="menu_glyph"/>
    <button function="menu" state="prelight" draw_ops="menu_prelight"/>
    <button function="menu" state="pressed" draw_ops="menu_pressed"/>
    <button function="shade" state="normal" draw_ops="blank"/>
    <button function="shade" state="prelight" draw_ops="blank"/>
    <button function="shade" state="pressed" draw_ops="blank"/>
    <button function="unshade" state="normal" draw_ops="blank"/>
    <button function="unshade" state="prelight" draw_ops="blank"/>
    <button function="unshade" state="pressed" draw_ops="blank"/>
    <button function="above" state="normal" draw_ops="blank"/>
    <button function="above" state="prelight" draw_ops="blank"/>
    <button function="above" state="pressed" draw_ops="blank"/>
    <button function="unabove" state="normal" draw_ops="blank"/>
    <button function="unabove" state="prelight" draw_ops="blank"/>
    <button function="unabove" state="pressed" draw_ops="blank"/>
    <button function="stick" state="normal" draw_ops="blank"/>
    <button function="stick" state="prelight" draw_ops="blank"/>
    <button function="stick" state="pressed" draw_ops="blank"/>
    <button function="unstick" state="normal" draw_ops="blank"/>
    <button function="unstick" state="prelight" draw_ops="blank"/>
    <button function="unstick" state="pressed" draw_ops="blank"/>
    <button function="left_left_background" state="normal" draw_ops="blank"/>
    <button function="left_left_background" state="prelight" draw_ops="blank"/>
    <button function="left_left_background" state="pressed" draw_ops="blank"/>
    <button function="left_middle_background" state="normal" draw_ops="blank"/>
    <button function="left_middle_background" state="prelight" draw_ops="blank"/>
    <button function="left_middle_background" state="pressed" draw_ops="blank"/>
    <button function="left_right_background" state="normal" draw_ops="blank"/>
    <button function="left_right_background" state="prelight" draw_ops="blank"/>
    <button function="left_right_background" state="pressed" draw_ops="blank"/>
    <button function="right_left_background" state="normal" draw_ops="blank"/>
    <button function="right_left_background" state="prelight" draw_ops="blank"/>
    <button function="right_left_background" state="pressed" draw_ops="blank"/>
    <button function="right_middle_background" state="normal" draw_ops="blank"/>
    <button function="right_middle_background" state="prelight" draw_ops="blank"/>
    <button function="right_middle_background" state="pressed" draw_ops="blank"/>
    <button function="right_right_background" state="normal" draw_ops="blank"/>
    <button function="right_right_background" state="prelight" draw_ops="blank"/>
    <button function="right_right_background" state="pressed" draw_ops="blank"/>
  </frame_style>

  <frame_style name="normal_unfocused" geometry="normal" parent="normal_focused">
    <piece position="entire_background" draw_ops="frame_unfocused"/>
    <piece position="title" draw_ops="title_unfocused"/>
    <button function="close" state="normal" draw_ops="close_unfocused"/>
    <button function="maximize" state="normal" draw_ops="maximize_unfocused"/>
    <button function="minimize" state="normal" draw_ops="minimize_unfocused"/>
  </frame_style>

  <frame_style name="maximized_focused" geometry="maximized" parent="normal_focused">
    <piece position="entire_background" draw_ops="frame_maximized_focused"/>
    <button function="maximize" state="normal" draw_ops="restore_focused"/>
    <button function="maximize" state="prelight" draw_ops="restore_prelight"/>
    <button function="maximize" state="pressed" draw_ops="restore_pressed"/>
  </frame_style>

  <frame_style name="maximized_unfocused" geometry="maximized" parent="normal_unfocused">
    <piece position="entire_background" draw_ops="frame_maximized_unfocused"/>
    <button function="maximize" state="normal" draw_ops="restore_unfocused"/>
    <button function="maximize" state="prelight" draw_ops="restore_prelight"/>
    <button function="maximize" state="pressed" draw_ops="restore_pressed"/>
  </frame_style>

  <frame_style name="small_focused" geometry="small" parent="normal_focused">
  </frame_style>

  <frame_style name="small_unfocused" geometry="small" parent="normal_unfocused">
  </frame_style>

  <frame_style name="border" geometry="border" parent="normal_focused">
    <piece position="entire_background" draw_ops="frame_focused"/>
    <piece position="titlebar" draw_ops="blank"/>
    <piece position="title" draw_ops="blank"/>
  </frame_style>

  <!-- Frame style sets -->

  <frame_style_set name="normal">
    <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
    <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
    <frame focus="yes" state="maximized" style="maximized_focused"/>
    <frame focus="no" state="maximized" style="maximized_unfocused"/>
    <frame focus="yes" state="shaded" style="normal_focused"/>
    <frame focus="no" state="shaded" style="normal_unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="maximized_focused"/>
    <frame focus="no" state="maximized_and_shaded" style="maximized_unfocused"/>
  </frame_style_set>

  <frame_style_set name="small">
    <frame focus="yes" state="normal" resize="both" style="small_focused"/>
    <frame focus="no" state="normal" resize="both" style="small_unfocused"/>
    <frame focus="yes" state="maximized" style="maximized_focused"/>
    <frame focus="no" state="maximized" style="maximized_unfocused"/>
    <frame focus="yes" state="shaded" style="small_focused"/>
    <frame focus="no" state="shaded" style="small_unfocused"/>
    <frame focus="yes" state="maximized_and_shaded" style="maximized_focused"/>
    <frame focus="no" state="maximized_and_shaded" style="maximized_unfocused"/>
  </frame_style_set>

  <frame_style_set name="border">
    <frame focus="yes" state="normal" resize="both" style="border"/>
    <frame focus="no" state="normal" resize="both" style="border"/>
    <frame focus="yes" state="maximized" style="border"/>
    <frame focus="no" state="maximized" style="border"/>
    <frame focus="yes" state="shaded" style="border"/>
    <frame focus="no" state="shaded" style="border"/>
    <frame focus="yes" state="maximized_and_shaded" style="border"/>
    <frame focus="no" state="maximized_and_shaded" style="border"/>
  </frame_style_set>

  <!-- Window types -->

  <window type="normal" style_set="normal"/>
  <window type="dialog" style_set="normal"/>
  <window type="modal_dialog" style_set="normal"/>
  <window type="menu" style_set="small"/>
  <window type="utility" style_set="small"/>
  <window type="border" style_set="border"/>
  <window version=">= 3.2" type="attached" style_set="border"/>

</metacity_theme>
