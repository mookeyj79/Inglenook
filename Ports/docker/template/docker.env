# {{meta.name}} for Docker build output: {{variant.name}}.
# Source this from your profile. Needs Docker with BuildKit (Docker 23 or newer).
# The names are terminal colors: set your terminal to {{variant.name}} too.

# run: finished steps. cancel: canceled steps. warning: steps with a warning.
# error: the step that failed.
BUILDKIT_COLORS=run=green:cancel=yellow:warning=yellow:error=red
