# {{meta.name}} for hexyl: {{variant.name}}.
# Source this from your profile. Needs hexyl 0.17 or newer.
# Palette {{meta.version}}, {{meta.repository}}

# The offset column on the left.
HEXYL_COLOR_OFFSET={{faint}}
# The null byte.
HEXYL_COLOR_NULL={{faint}}
# Printable ASCII characters.
HEXYL_COLOR_ASCII_PRINTABLE={{success}}
# Spaces, tabs and line breaks.
HEXYL_COLOR_ASCII_WHITESPACE={{dim}}
# Other ASCII bytes, such as control characters.
HEXYL_COLOR_ASCII_OTHER={{literal}}
# Bytes above 0x7F.
HEXYL_COLOR_NONASCII={{keyword}}
