{
  "kind": "app",
  "platform": "linux",
  "version": "13.4.0",
  "install": [
    "curl -fsSL --retry 5 --retry-all-errors -o /tmp/insomnia.deb \"https://github.com/Kong/insomnia/releases/download/core%40$INGLENOOK_VERSION/Insomnia.Core-$INGLENOOK_VERSION.deb\" && echo 'b566d3d6b5a59d4baf0e705f156889f5bcbcfc9822930dcb5b5a180b8e5e9d4d  /tmp/insomnia.deb' | sha256sum -c - && apt-get install -y --no-install-recommends /tmp/insomnia.deb fonts-ibm-plex && rm /tmp/insomnia.deb && apt-get clean"
  ],
  "apply": [
    "d=\"${XDG_CONFIG_HOME:-$HOME/.config}/Insomnia/plugins/insomnia-plugin-inglenook-$INGLENOOK_VARIANT\" && mkdir -p \"$d\" && cp \"$INGLENOOK_PORT/dist/$INGLENOOK_VARIANT/\"* \"$d/\"",
    "printf '{\"_id\":\"set_scene\",\"type\":\"Settings\",\"parentId\":null,\"modified\":1,\"created\":1,\"theme\":\"inglenook-%s\"}\\n' \"$INGLENOOK_VARIANT\" > \"${XDG_CONFIG_HOME:-$HOME/.config}/Insomnia/insomnia.Settings.db\""
  ],
  "stage": [
    "sed -i '$ s/}$/,\"fontMonospace\":\"IBM Plex Mono\",\"editorFontSize\":13,\"enableAnalytics\":false,\"disableUpdateNotification\":true,\"updateAutomatically\":false,\"hasSeenSidebarFocusOnboarding\":true,\"autoHideMenuBar\":true}/' \"${XDG_CONFIG_HOME:-$HOME/.config}/Insomnia/insomnia.Settings.db\"",
    "bash \"$INGLENOOK_SCENE/insomnia/seed.sh\""
  ],
  "launch": [
    "bash \"$INGLENOOK_SCENE/insomnia/run.sh\""
  ],
  "window": {
    "title": "^Insomnia 13\\.4\\.0$"
  }
}
