{
  "kind": "web",
  "platform": "linux",
  "install": [
    "apt-get install -y --no-install-recommends fonts-ibm-plex"
  ],
  "apply": [
    "mkdir -p ~/site/css",
    "cp \"$INGLENOOK_PORT/dist/day/inglenook-day.css\" ~/site/css/",
    "cp \"$INGLENOOK_PORT/dist/night/inglenook-night.css\" ~/site/css/"
  ],
  "stage": [
    "bash \"$INGLENOOK_SCENE/web/stage.sh\" ~/site"
  ],
  "launch": [
    "bash \"$INGLENOOK_SCENE/browser.sh\" \"file://$HOME/site/index.html#$INGLENOOK_VARIANT\""
  ],
  "window": {
    "title": "^Moss, a shade softer$"
  }
}
