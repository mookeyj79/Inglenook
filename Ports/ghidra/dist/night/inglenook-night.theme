# Inglenook Night for Ghidra, from Inglenook 0.1.0 (https://github.com/mookeyj79/Inglenook)
# Import with Edit > Theme > Import... in the Ghidra project window.
name = Inglenook Night
lookAndFeel = Flat Dark
useDarkDefaults = true

# Look and Feel groups: every Swing widget takes its colors from these
[color]system.color.bg.view = #1b1917
[color]system.color.fg.view = #d1c9bc
[color]system.color.bg.control = #262321
[color]system.color.fg.control = #d1c9bc
[color]system.color.bg.selected.view = #463624
[color]system.color.fg.selected.view = #d1c9bc
[color]system.color.bg.tooltip = #262321
[color]system.color.fg.tooltip = #d1c9bc
[color]system.color.bg.border = #363331
[color]system.color.fg.disabled = #8f887f

# Look and Feel surfaces the groups do not reach
[laf.color]Panel.background = #171412
[laf.color]SplitPane.background = #171412
