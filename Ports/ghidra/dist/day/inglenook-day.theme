# Inglenook Day for Ghidra, from Inglenook 0.1.1 (https://github.com/mookeyj79/Inglenook)
# Import with Edit > Theme > Import... in the Ghidra project window.
name = Inglenook Day
lookAndFeel = Flat Light
useDarkDefaults = false

# Look and Feel groups: every Swing widget takes its colors from these
[color]system.color.bg.view = #f1f3ee
[color]system.color.fg.view = #2d373f
[color]system.color.bg.control = #f9fbf8
[color]system.color.fg.control = #2d373f
[color]system.color.bg.selected.view = #e3dbc8
[color]system.color.fg.selected.view = #2d373f
[color]system.color.bg.tooltip = #f9fbf8
[color]system.color.fg.tooltip = #2d373f
[color]system.color.bg.border = #cfd2cb
[color]system.color.fg.disabled = #657178

