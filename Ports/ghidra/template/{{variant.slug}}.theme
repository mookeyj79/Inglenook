color.fg.filterfield = {{text}}
color.border.bevel.highlight = {{line}}
color.border.bevel.shadow = {{line}}
color.border.provider.disconnected = {{warning}}
color.border.button.focused = {{accent}}
color.fg.button = {{text}}
color.bg.filechooser.shortcut = {{deep}}
color.bg.widget.tabs.selected.active = {{accent|wash}}
color.bg.widget.tabs.selected.inactive = {{hover}}
color.bg.widget.tabs.unselected = {{deep}}
color.bg.widget.tabs.highlighted = {{hover}}
color.fg.widget.tabs.selected.active = {{text}}
color.fg.widget.tabs.unselected = {{dim}}
color.bg.widget.tabs.list = {{raised}}
color.bg.widget.tabs.more.tabs.hover = {{hover}}
color.bg.formatted.field.error = {{error|wash}}
color.bg.formatted.field.editing = {{warning|wash}}
color.fg.formatted.field.editing = {{text}}
color.bg.messageoverlay = {{raised}}
color.fg.messageoverlay = {{text}}
color.bg.undefined = {{deep}}
color.fg.table.offcut.selected = {{error}}
