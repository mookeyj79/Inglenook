# {{variant.name}} for Ghidra, from {{meta.name}} {{meta.version}} ({{meta.repository}})
# Import with Edit > Theme > Import... in the Ghidra project window.
name = {{variant.name}}
lookAndFeel = {{port.look_and_feel}}
useDarkDefaults = {{port.dark_defaults}}

# Look and Feel groups: every Swing widget takes its colors from these
[color]system.color.bg.view = {{base}}
[color]system.color.fg.view = {{text}}
[color]system.color.bg.control = {{raised}}
[color]system.color.fg.control = {{text}}
[color]system.color.bg.selected.view = {{accent|wash}}
[color]system.color.fg.selected.view = {{text}}
[color]system.color.bg.tooltip = {{raised}}
[color]system.color.fg.tooltip = {{text}}
[color]system.color.bg.border = {{line}}
[color]system.color.fg.disabled = {{faint}}

# Look and Feel surfaces the groups do not reach
[laf.color]Panel.background = {{deep}}
[laf.color]SplitPane.background = {{deep}}
[laf.color]ToolBar.background = {{deep}}
[laf.color]MenuBar.background = {{deeper}}
[laf.color]MenuBar.borderColor = {{line}}
[laf.color]MenuBar.hoverBackground = {{hover}}
[laf.color]PopupMenu.background = {{raised}}
[laf.color]PopupMenu.borderColor = {{line}}
[laf.color]Menu.background = {{deeper}}
[laf.color]Menu.selectionBackground = {{accent}}
[laf.color]Menu.selectionForeground = {{on_accent}}
[laf.color]MenuItem.background = {{raised}}
[laf.color]MenuItem.selectionBackground = {{accent}}
[laf.color]MenuItem.selectionForeground = {{on_accent}}
[laf.color]MenuItem.acceleratorForeground = {{dim}}
[laf.color]CheckBoxMenuItem.selectionBackground = {{accent}}
[laf.color]CheckBoxMenuItem.selectionForeground = {{on_accent}}
[laf.color]RadioButtonMenuItem.selectionBackground = {{accent}}
[laf.color]RadioButtonMenuItem.selectionForeground = {{on_accent}}
[laf.color]Separator.foreground = {{line}}
[laf.color]Component.borderColor = {{line}}
[laf.color]Component.disabledBorderColor = {{line}}
[laf.color]Component.focusColor = {{accent}}
[laf.color]Component.focusedBorderColor = {{accent}}
[laf.color]Button.background = {{raised}}
[laf.color]Button.hoverBackground = {{hover}}
[laf.color]Button.pressedBackground = {{hover}}
[laf.color]Button.borderColor = {{line}}
[laf.color]Button.default.background = {{accent}}
[laf.color]Button.default.foreground = {{on_accent}}
[laf.color]Button.default.hoverBackground = {{accent}}
[laf.color]Button.default.borderColor = {{accent}}
[laf.color]ToggleButton.selectedBackground = {{hover}}
[laf.color]TextField.background = {{raised}}
[laf.color]FormattedTextField.background = {{raised}}
[laf.color]PasswordField.background = {{raised}}
[laf.color]ComboBox.background = {{raised}}
[laf.color]ComboBox.buttonBackground = {{raised}}
[laf.color]Spinner.background = {{raised}}
[laf.color]TextField.caretForeground = {{accent}}
[laf.color]TextArea.caretForeground = {{accent}}
[laf.color]TextPane.caretForeground = {{accent}}
[laf.color]EditorPane.caretForeground = {{accent}}
[laf.color]TextField.placeholderForeground = {{faint}}
[laf.color]TabbedPane.background = {{deep}}
[laf.color]TabbedPane.selectedBackground = {{base}}
[laf.color]TabbedPane.hoverColor = {{hover}}
[laf.color]TabbedPane.underlineColor = {{accent}}
[laf.color]TabbedPane.inactiveUnderlineColor = {{faint}}
[laf.color]TabbedPane.contentAreaColor = {{line}}
[laf.color]ScrollBar.track = {{deep}}
[laf.color]ScrollBar.thumb = {{line}}
[laf.color]ScrollBar.hoverThumbColor = {{faint}}
[laf.color]ScrollBar.pressedThumbColor = {{faint}}
[laf.color]TableHeader.background = {{deep}}
[laf.color]TableHeader.foreground = {{text}}
[laf.color]TableHeader.separatorColor = {{line}}
[laf.color]TableHeader.bottomSeparatorColor = {{line}}
[laf.color]Table.gridColor = {{line}}
[laf.color]Table.selectionInactiveBackground = {{accent|wash}}
[laf.color]Table.selectionInactiveForeground = {{text}}
[laf.color]Tree.selectionInactiveBackground = {{accent|wash}}
[laf.color]Tree.selectionInactiveForeground = {{text}}
[laf.color]List.selectionInactiveBackground = {{accent|wash}}
[laf.color]List.selectionInactiveForeground = {{text}}
[laf.color]ProgressBar.background = {{deep}}
[laf.color]ProgressBar.foreground = {{accent}}
[laf.color]ProgressBar.selectionBackground = {{text}}
[laf.color]ProgressBar.selectionForeground = {{on_accent}}
[laf.color]CheckBox.icon.checkmarkColor = {{on_accent}}
[laf.color]CheckBox.icon.selectedBackground = {{accent}}
[laf.color]CheckBox.icon.selectedBorderColor = {{accent}}
[laf.color]Hyperlink.linkColor = {{accent}}

# Shared app colors
color.fg.error = {{error}}
