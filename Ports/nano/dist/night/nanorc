# Inglenook Night for nano, from Inglenook 0.1.1.
# Put these lines at the end of your own nanorc (~/.config/nano/nanorc or ~/.nanorc).
# nano reads interface colors only from a nanorc, never from an included file.
# The color names are terminal colors: set your terminal to Inglenook Night too.
set titlecolor lightwhite,black
set promptcolor lightwhite,black
set minicolor lightwhite,black
set statuscolor lightwhite,black
set errorcolor bold,black,red
set keycolor bold,blue
set functioncolor lightwhite
set numbercolor lightblack
set selectedcolor black,lightwhite
set spotlightcolor black,blue
set stripecolor ,black
set scrollercolor lightblack
